{
  "$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!!**/.agents",
      "!!**/.github",
      "!!**/.astro",
      "!!**/.wrangler",
      "!!**/dist",
      "!!**/pnpm-lock.yaml",
      "!!**/*.md",
      "!!**/*.mdx"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "all",
      "correctness": {
        "useQwikValidLexicalScope": "off"
      },
      "suspicious": {
        "noExplicitAny": "error"
      },
      "style": {
        "noDefaultExport": "off",
        "noExcessiveLinesPerFile": "off",
        "useExportsLast": "off"
      },
      "complexity": {
        "useLiteralKeys": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.astro"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedImports": "off",
            "noUnusedVariables": "off",
            "noUnresolvedImports": "off",
            "useImportExtensions": "off"
          }
        }
      }
    },
    {
      "includes": [
        "src/content.config.ts",
        "src/lib/research.ts",
        "src/lib/tags.ts"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noUnresolvedImports": "off"
          }
        }
      }
    },
    {
      "includes": ["astro.config.mjs", "scripts/**/*.mjs"],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off"
          }
        }
      }
    },
    {
      "includes": ["scripts/**/*.test.mjs"],
      "linter": {
        "rules": {
          "suspicious": {
            "noMisplacedAssertion": "off",
            "useExpect": "off",
            "noConditionalExpect": "off"
          },
          "performance": {
            "useTopLevelRegex": "off"
          }
        }
      }
    },
    {
      "includes": ["scripts/evidence.mjs"],
      "linter": {
        "rules": {
          "suspicious": {
            "noMisplacedAssertion": "off"
          }
        }
      }
    },
    {
      "includes": ["src/styles/global.css"],
      "linter": {
        "rules": {
          "complexity": {
            "noImportantStyles": "off"
          },
          "style": {
            "noDescendingSpecificity": "off"
          },
          "suspicious": {
            "useBaseline": "off"
          }
        }
      }
    }
  ]
}
