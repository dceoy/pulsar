{
  "name": "pulsar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24.16.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "pnpm build && wrangler deploy",
    "format": "biome format --write . && prettier --write \"**/*.{md,mdx}\"",
    "format:check": "biome format . && prettier --check \"**/*.{md,mdx}\"",
    "lint": "oxlint . --deny-warnings && biome lint .",
    "lint:fix": "oxlint . --fix && biome lint --write ."
  },
  "dependencies": {
    "astro": "7.3.5",
    "@astrojs/markdown-remark": "7.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@biomejs/biome": "2.5.14",
    "oxlint": "1.79.0",
    "typescript": "6.0.3",
    "wrangler": "4.147.0",
    "prettier": "3.9.9"
  }
}
