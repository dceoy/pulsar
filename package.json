{
  "name": "pulsar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24.22.1",
    "pnpm": ">=12"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro sync && astro-check",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "pnpm build && wrangler deploy",
    "format": "biome format --write . && oxfmt --write '**/*.{md,mdx}' --no-error-on-unmatched-pattern",
    "format:check": "biome format . && oxfmt --check '**/*.{md,mdx}' --no-error-on-unmatched-pattern",
    "lint": "oxlint . && biome lint . --error-on-warnings --max-diagnostics=250 && markdownlint-cli2 '**/*.{md,mdx,markdown}'",
    "lint:fix": "oxlint --fix . && biome lint --write . && markdownlint-cli2 --fix '**/*.{md,mdx,markdown}'",
    "lint:markdown": "node scripts/markdownlint.mjs",
    "test:markdownlint": "node --test scripts/markdownlint.test.mjs",
    "test:evidence": "node --test scripts/evidence.test.mjs",
    "test:research": "node --test scripts/research-pages.test.mjs",
    "typecheck": "astro sync && tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.10",
    "astro": "7.4.13"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@biomejs/biome": "2.6.8",
    "katex": "0.19.1",
    "markdownlint": "0.42.2",
    "markdownlint-cli2": "0.24.1",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "wrangler": "4.165.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.22.1",
      "onFail": "download"
    }
  }
}
