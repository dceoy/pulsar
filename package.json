{
  "name": "pulsar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24.22.1",
    "pnpm": ">=12"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "pnpm build && wrangler deploy",
    "format": "biome format --write . && oxfmt --write '**/*.{md,mdx}' --no-error-on-unmatched-pattern",
    "format:check": "biome format . && oxfmt --check '**/*.{md,mdx}' --no-error-on-unmatched-pattern",
    "lint": "oxlint . --deny-warnings && biome lint .",
    "lint:fix": "oxlint . --fix && biome lint --write .",
    "lint:markdown": "node scripts/markdownlint.mjs",
    "test:markdownlint": "node --test scripts/markdownlint.test.mjs",
    "test:evidence": "node --test scripts/evidence.test.mjs",
    "test:research": "node --test scripts/research-pages.test.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.4",
    "astro": "7.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@biomejs/biome": "2.6.2",
    "katex": "0.19.0",
    "markdownlint": "0.42.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "wrangler": "4.152.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.22.1",
      "onFail": "download"
    }
  }
}
