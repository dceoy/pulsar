{
  "name": "pulsar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24.16.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "pnpm build && wrangler deploy",
    "format": "biome format --write . && prettier --write \"**/*.{md,mdx}\"",
    "format:check": "biome format . && prettier --check \"**/*.{md,mdx}\"",
    "lint": "oxlint . --deny-warnings && biome lint .",
    "lint:fix": "oxlint . --fix && biome lint --write .",
    "lint:markdown": "node scripts/markdownlint.mjs",
    "test:markdownlint": "node --test scripts/markdownlint.test.mjs",
    "test:evidence": "node --test scripts/evidence.test.mjs",
    "test:research": "node --test scripts/research-pages.test.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.2",
    "astro": "7.3.6"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@biomejs/biome": "2.5.15",
    "katex": "0.19.0",
    "markdownlint": "0.41.1",
    "oxlint": "1.87.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "wrangler": "4.148.0"
  }
}
