---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import { tagHref } from '../../lib/tags';
import { formatPublishedAt } from '../../lib/research';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleProvenance from '../../components/ArticleProvenance.astro';

export const getStaticPaths = (async () =>
  (await getCollection('articles')).map((article) => ({
    params: { id: article.id },
    props: { article },
  }))) satisfies GetStaticPaths;
const { article } = Astro.props;
const { Content } = await render(article);
const { title, description, tags, publishedAt, aiAgent, aiModel } = article.data;
---

<BaseLayout
  title={title}
  description={description}
  aiAgent={aiAgent}
  aiModel={aiModel}
>
  <article class="reading" data-ai-agent={aiAgent} data-ai-model={aiModel}>
    <header class="hero compact">
      <p class="eyebrow">
        {tags.map((tag) => (
          <span class="tag-labels">
            <a href={tagHref(tag)}>{tag}</a>
            <span class="eyebrow-sep" aria-hidden="true">·</span>
          </span>
        ))}
        <time datetime={publishedAt.toISOString()}>
          {formatPublishedAt(publishedAt)}
        </time>
      </p>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      <ArticleProvenance aiAgent={aiAgent} aiModel={aiModel} />
    </header>
    <div class="prose">
      <Content />
    </div>
    <p class="article-back">
      <a href="/">Back to latest research <span aria-hidden="true">↗</span></a>
    </p>
  </article>
</BaseLayout>
