---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import { tagHref } from '../../lib/tags';
import BaseLayout from '../../layouts/BaseLayout.astro';

export const getStaticPaths = (async () =>
  (await getCollection('articles')).map((article) => ({
    params: { id: article.id },
    props: { article },
  }))) satisfies GetStaticPaths;
const { article } = Astro.props;
const { Content } = await render(article);
const { title, description, tags, publishedAt } = article.data;
---

<BaseLayout title={title} description={description}>
  <article class="reading">
    <header class="hero compact">
      <p class="eyebrow">
        {tags.map((tag) => (
          <span>
            <a href={tagHref(tag)}>{tag}</a>
            <span class="eyebrow-sep" aria-hidden="true">·</span>
          </span>
        ))}
        <time datetime={publishedAt.toISOString()}>
          {publishedAt.toLocaleDateString('en', {
            dateStyle: 'long',
            timeZone: 'UTC',
          })}
        </time>
      </p>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
    </header>
    <div class="prose">
      <Content />
    </div>
    <p class="article-back">
      <a href="/">Back to latest reading <span aria-hidden="true">↗</span></a>
    </p>
  </article>
</BaseLayout>
