---
import { getCollection } from 'astro:content';
import ArticleCard from '../components/ArticleCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getTags, tagHref } from '../lib/tags';

const articles = (await getCollection('articles')).sort(
  (a, b) =>
    b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf() ||
    a.id.localeCompare(b.id),
);
const tags = getTags(articles);
---

<BaseLayout
  title="A clearer signal"
  description="News intelligence across science, technology, business, finance, and global affairs."
>
  <section class="hero" aria-labelledby="intro">
    <p class="eyebrow">Pulsar / The reading room</p>
    <h1 id="intro">
      Find the signal.
      <br />
      <span>See the bigger picture.</span>
    </h1>
    <p class="lede">
      Explore ideas shaping science, technology, business, and global affairs.
      Clear context for a connected world.
    </p>
    <a class="text-link" href="#latest">
      Explore the reading room <span aria-hidden="true">↗</span>
    </a>
  </section>
  <section class="section" aria-labelledby="latest">
    <div class="section-heading">
      <h2 id="latest">Latest reading</h2>
      <p>Sample articles · A first look at Pulsar</p>
    </div>
    <div class="article-grid">
      {articles.map((article) => (
        <ArticleCard article={article} />
      ))}
    </div>
  </section>
  {tags.length > 0 && (
    <section class="section" aria-labelledby="topics-heading">
      <div class="section-heading">
        <h2 id="topics-heading">Explore tags</h2>
        <p>Topics from published articles</p>
      </div>
      <ul class="category-grid">
        {tags.map((tag, index) => (
          <li>
            <a href={tagHref(tag)}>
              <span class="eyebrow">{String(index + 1).padStart(2, '0')}</span>
              <span>{tag}</span>
              <span aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>
