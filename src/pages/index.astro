---
import { getCollection } from 'astro:content';
import ResearchBrief from '../components/ResearchBrief.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getResearchReports, formatPublishedAt } from '../lib/research';
import { getTags, tagHref } from '../lib/tags';

const articles = await getCollection('articles');
const reports = getResearchReports(articles);
const latest = reports[0];
const tags = getTags(articles);
---

<BaseLayout
  title="Latest research"
  description="Complete news research briefings, with dated analysis and linked sources."
>
  {latest ? (
    <>
      <ResearchBrief report={latest} />
      <p class="research-permalink">
        <a href={`/research/${latest.id}/`}>Permanent link to this research briefing ↗</a>
      </p>
    </>
  ) : (
    <section class="hero">
      <h1>Research briefings</h1>
      <p class="lede">No research has been published yet.</p>
    </section>
  )}
  {reports.length > 1 && (
    <section class="section" aria-labelledby="archive">
      <div class="section-heading">
        <h2 id="archive">Earlier research</h2>
        <p>Complete reports, newest first</p>
      </div>
      <ul class="research-archive">
        {reports.slice(1).map((report) => (
          <li>
            <a href={`/research/${report.id}/`}>{report.id}</a>
            <time datetime={report.publishedAt.toISOString()}>
              {formatPublishedAt(report.publishedAt)}
            </time>
          </li>
        ))}
      </ul>
    </section>
  )}
  {tags.length > 0 && (
    <section class="section" aria-labelledby="topics-heading">
      <div class="section-heading">
        <h2 id="topics-heading">Explore tags</h2>
        <p>Topics from published research</p>
      </div>
      <ul class="category-grid">
        {tags.map((tag, index) => (
          <li>
            <a href={tagHref(tag)}>
              <span class="eyebrow">{String(index + 1).padStart(2, '0')}</span>
              <span>{tag}</span>
              <span aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>
