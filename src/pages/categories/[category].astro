---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import ArticleCard from '../../components/ArticleCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTags } from '../../lib/tags';

export const getStaticPaths = (async () => {
  const articles = (await getCollection('articles')).sort(
    (a, b) =>
      b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf() ||
      a.id.localeCompare(b.id),
  );
  return getTags(articles).map((tag) => ({
    params: { category: tag },
    props: {
      tag,
      articles: articles.filter((article) => article.data.tags.includes(tag)),
    },
  }));
}) satisfies GetStaticPaths;

const { tag, articles } = Astro.props;
---

<BaseLayout
  title={tag}
  description={`Explore Pulsar articles tagged ${tag}.`}
>
  <section class="hero compact">
    <p class="eyebrow">The reading room / Topic</p>
    <h1>{tag}</h1>
    <p class="lede">Articles tagged {tag}.</p>
  </section>
  <section class="section" aria-labelledby="articles-heading">
    <h2 id="articles-heading">Reading in {tag}</h2>
    <div class="article-grid">
      {articles.map((article) => (
        <ArticleCard article={article} />
      ))}
    </div>
  </section>
</BaseLayout>
