---
import { getCollection } from 'astro:content';
import { getTags, tagHref } from '../lib/tags';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  aiAgent?: string;
  aiModel?: string;
}

const { title, description, noindex = false, aiAgent, aiModel } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const tags = getTags(await getCollection('articles'));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#07090e" />
    <title>{title} | Pulsar</title>
    <meta name="description" content={description} />
    {aiAgent && <meta name="pulsar:ai-agent" content={aiAgent} />}
    {aiModel && <meta name="pulsar:ai-model" content={aiModel} />}
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <link rel="canonical" href={canonical} />
    )}
    <meta property="og:title" content={`${title} | Pulsar`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {!noindex && <meta property="og:url" content={canonical} />}
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header">
      <div class="site-header-inner wrapper">
        <a class="brand" href="/" aria-label="Pulsar home">
          <span class="brand-mark" aria-hidden="true"></span> Pulsar
        </a>
        <nav aria-label="Topics">
          <ul class="topics">
            {tags.map((tag) => (
              <li>
                <a
                  href={tagHref(tag)}
                  aria-current={Astro.url.pathname === tagHref(tag) ? 'page' : undefined}
                >
                  {tag}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <main id="main" class="wrapper" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-footer-inner wrapper">
        <p>Pulsar · A wider view. A clearer signal.</p>
        <a href="/">Back to home</a>
      </div>
    </footer>
  </body>
</html>
