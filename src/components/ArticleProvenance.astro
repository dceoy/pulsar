---
interface Props {
  authoringTool?: string;
  authoringModel?: string;
}

const { authoringTool, authoringModel } = Astro.props;
---

{(authoringTool || authoringModel) && (
  <p class="ai-provenance">
    AI provenance:
    {authoringTool && <span> Tool: {authoringTool}</span>}
    {authoringTool && authoringModel && <span aria-hidden="true"> · </span>}
    {authoringModel && <span>Model: {authoringModel}</span>}
  </p>
)}
